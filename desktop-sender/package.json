{
  "name": "castviewer",
  "productName": "CastViewer",
  "version": "1.1.0",
  "description": "CastViewer - Espelhamento local ultra-rápido para Fire TV",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check hardware-profile.js && node --check wayland-session.js && node --check mp4-defragment.js && node --check renderer/replay-buffer.js && node --check renderer/takeover-state.js && node --check renderer/renderer.js && node --check renderer/pcm-worklet.js && node --test test/hardware-profile.test.js test/wayland-macos.test.js test/replay-buffer.test.js test/takeover-state.test.js test/mp4-defragment.test.js",
    "build:win": "electron-builder --win dir",
    "dist:win": "electron-builder --win nsis portable dir",
    "build:linux": "electron-builder --linux AppImage deb tar.gz",
    "dist:linux": "electron-builder --linux AppImage deb tar.gz",
    "build:mac": "electron-builder --mac dmg --universal",
    "dist:mac": "electron-builder --mac dmg --universal"
  },
  "keywords": [
    "castviewer",
    "firecast",
    "webrtc",
    "screen-sharing",
    "firetv",
    "electron"
  ],
  "homepage": "https://github.com/EduardoCoura/castviewer",
  "repository": {
    "type": "git",
    "url": "https://github.com/EduardoCoura/castviewer.git"
  },
  "author": "Eduardo Coura <160511622+EduardoCoura@users.noreply.github.com>",
  "license": "GPL-3.0",
  "dependencies": {
    "bonjour-service": "^1.3.0"
  },
  "optionalDependencies": {
    "loopback-capture": "^4.0.0"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.castviewer.app",
    "productName": "CastViewer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "hardware-profile.js",
      "wayland-session.js",
      "mp4-defragment.js",
      "renderer/**/*",
      "assets/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/loopback-capture/**",
      "node_modules/bindings/**",
      "node_modules/file-uri-to-path/**",
      "scripts/**"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "assets/castviewer_v2.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CastViewer",
      "installerIcon": "assets/castviewer_v2.ico",
      "uninstallerIcon": "assets/castviewer_v2.ico"
    },
    "portable": {
      "artifactName": "CastViewer-Portable-${version}.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo",
      "synopsis": "Espelhamento local ultra-rápido para Fire TV",
      "description": "CastViewer - Espelhamento de tela e áudio do sistema em rede local (LAN) via WebRTC com baixa latência para Fire TV.",
      "artifactName": "CastViewer-Linux-${version}-${arch}.${ext}",
      "desktop": {
        "StartupWMClass": "CastViewer",
        "Keywords": "cast;screen;mirror;firetv;webrtc;"
      }
    },
    "appImage": {
      "artifactName": "CastViewer-Linux-${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "CastViewer-Linux-${version}-${arch}.${ext}",
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libayatana-appindicator3-1 | libappindicator3-1"
      ],
      "recommends": [
        "libpipewire-0.3-0t64 | libpipewire-0.3-0",
        "pulseaudio-utils",
        "playerctl"
      ]
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "CastViewer-macOS-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "mergeASARs": true,
      "files": [
        "!node_modules/loopback-capture/**",
        "!scripts/*.ps1"
      ],
      "asarUnpack": [],
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "CastViewer usa a rede local (LAN/mDNS) para descobrir e transmitir tela e áudio para o seu Fire TV.",
        "NSBonjourServices": [
          "_firecast._tcp"
        ],
        "NSScreenCaptureUsageDescription": "CastViewer precisa de permissão de Gravação de Tela para espelhar seu Mac na Fire TV.",
        "NSAudioCaptureUsageDescription": "CastViewer precisa capturar o áudio do sistema para enviá-lo sincronizado junto com a tela para a Fire TV."
      }
    },
    "dmg": {
      "title": "CastViewer ${version}",
      "icon": "assets/icon.icns",
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
